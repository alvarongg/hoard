{
  "enabled": true,
  "name": "Lint Frontend TypeScript",
  "description": "Ejecuta ESLint automáticamente cuando se edita un archivo TypeScript o TSX del frontend para detectar problemas de código tempranamente.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "frontend/**/*.ts",
      "frontend/**/*.tsx"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "npx eslint --no-error-on-unmatched-pattern ${file}"
  }
}
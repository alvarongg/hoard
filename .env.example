# Database
POSTGRES_USER=hoard
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hoard
DATABASE_URL=postgresql+asyncpg://hoard:changeme@db:5432/hoard

# Backend
SECRET_KEY=change-this-to-a-random-secret-key
CORS_ORIGINS=http://localhost,http://localhost:3000
UPLOAD_DIR=/app/uploads

# Search
# Similarity threshold for fuzzy search (0.0 to 1.0, higher = stricter matching)
# Recommended range: 0.2-0.4 for most use cases
SEARCH_SIMILARITY_THRESHOLD=0.3

# Frontend
VITE_API_URL=/api
